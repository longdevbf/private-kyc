// =====================================================================
// Private Credential Lifecycle Engine — deployable port
// =====================================================================
// Targets compiler 0.31.1 / language 0.23 / compact-runtime 0.16.0.
//
// WHY THIS FILE EXISTS
// The reference implementation in contracts/src/credential.compact targets
// compiler 0.34.0 / language 0.26, where `jubjubSchnorrVerify` is a stdlib
// builtin. No live Midnight network runs that stack: the official support
// matrix pins compiler 0.31.1 / compact-runtime 0.16.0 / on-chain runtime
// 3.0.0 for preview, preprod and mainnet alike (RESEARCH.md §G).
//
// Compiler 0.31.1 accepts language 0.23 only, and language 0.23 has no
// in-circuit signature verification of any kind -- nine candidate names
// were tried and every one is unbound (RESEARCH.md §G.3). So this port
// cannot verify an issuer signature, and the issuer-authorisation model
// is rebuilt on a primitive 0.23 does have.
//
// WHAT CHANGED, AND WHAT IT COSTS
// Reference version: the issuer signs H(commitment, holderId) with a
// Jubjub key whose public half sits in ledger state. The signature is
// produced once at issuance and re-verified at every presentation, so the
// attestation is a portable object the holder carries.
//
// This version: the issuer proves knowledge of a secret whose digest sits
// in ledger state. Only `issueCredential` and `revokeCredential` check it,
// and the holder never sees it. At presentation there is no signature to
// check; instead the tree leaf binds the issuer id, and membership in a
// tree only `issueCredential` can write to IS the attestation.
//
// The honest cost of that substitution:
//   * Issuer authority is a capability secret, not a public key. It cannot
//     be verified by a third party who does not hold it, and an attestation
//     cannot be checked offline -- everything routes through the tree.
//   * There is no transferable attestation object. A holder cannot hand a
//     verifier a signature; they can only prove membership.
//   * Anyone who learns the secret can issue and revoke. A signature scheme
//     has the same property for its signing key, but the blast radius is
//     easier to reason about when the public half is separate.
// What is preserved: only a registered issuer can issue or revoke (I6), the
// credential is bound to one holder (I7), revocation is immediate (I2),
// expiry is enforced privately (I3), replay is caught (I4), and presentations
// are unlinkable across verifiers (I5).
//
// PUBLIC / PRIVATE SPLIT — unchanged from the reference version.
//   Public  (ledger):  who may issue, which credentials are live, which
//                      nullifiers are spent, the revocation epoch.
//   Private (witness): attribute VALUES, the blinding factor, the holder's
//                      secret, the issuer's secret, the Merkle path.
// No attribute value ever crosses into ledger state. Every disclose() below
// carries a comment justifying that specific disclosure.
// =====================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

// Language 0.23 rejects a module-qualified type reference (`M.S` is a parse
// error), so the predicate types the reference version keeps in
// contracts/src/Predicates.compact are inlined here rather than imported.
// The logic is identical; only the packaging differs.

// ---------------------------------------------------------------------
// PREDICATE TYPES
// ---------------------------------------------------------------------

// Attribute values. NEVER written to ledger state.
export struct CredentialAttrs {
  birthTimestamp: Uint<64>;   // unix seconds
  countryCode:    Uint<16>;   // ISO 3166-1 numeric
  kycTier:        Uint<8>;
  expiresAt:      Uint<64>;   // unix seconds
}

export enum PredicateId {
  AGE_AT_LEAST,      // threshold = minimum age, in seconds
  TIER_AT_LEAST,     // threshold = minimum kycTier
  COUNTRY_IN_SET     // allowedCountries = permitted ISO numeric codes
}

// One request struct keeps the present() signature stable as predicates are
// added -- a new predicate reuses `threshold` or adds a field here, rather
// than changing every call site.
export struct PredicateRequest {
  predicateId:      PredicateId;
  threshold:        Uint<64>;
  allowedCountries: Vector<8, Uint<16>>;
}

// ---------------------------------------------------------------------
// PUBLIC LEDGER STATE
// ---------------------------------------------------------------------

// Authorised issuers: id -> digest of the issuer's authorisation secret.
//
// This is where the port diverges from the reference version, which stores
// a Jubjub verification key here. A digest is not a public key: it does not
// let a third party verify anything, it only lets the CIRCUIT check that
// whoever is calling knows the preimage. That is enough to gate issuance
// and revocation, and it is the strongest thing language 0.23 can express.
export ledger issuerAuth: Map<Uint<16>, Bytes<32>>;

// The ACTIVE set. Membership implies non-revocation. Merkle trees give
// membership proofs, not non-membership proofs, so the set is inverted:
// holders prove they are still IN the live set rather than absent from a
// revocation list. A public blacklist would leak exactly what we protect.
//
// In this port the leaves carry more than the reference version's leaves
// do -- see credentialLeaf() for why that is load-bearing here.
export ledger activeCredentials: HistoricMerkleTree<10, Bytes<32>>;

// Spent per-verifier nullifiers. Public by necessity: this is the replay
// check. Reveals nothing linkable -- see the nullifier derivation below.
export ledger spentNullifiers: Map<Bytes<32>, Boolean>;

// Which issuer owns which leaf. Closes two holes found while testing the
// reference version and carried over unchanged:
//   * revoking an EMPTY index used to succeed. It changed nothing in the
//     tree but still bumped the epoch and cleared root history, letting any
//     registered issuer invalidate every holder's Merkle path for free.
//   * revoking ANOTHER issuer's leaf used to succeed, so one registered
//     issuer could destroy a competitor's credentials.
// The tree ADT exposes no way to test occupancy in-circuit, so occupancy is
// tracked alongside it.
export ledger leafIssuer: Map<Uint<64>, Uint<16>>;

// Bumped on every revocation. Also scopes nullifiers, so replay protection
// resets each epoch.
export ledger revocationEpoch: Counter;

// Contract administrator, as a hash of a secret. Sealed: fixed at deploy.
// Authentication is preimage knowledge, NOT ownPublicKey() -- that is a
// witness the DApp controls and is not bound to the transaction signer.
export sealed ledger admin: Bytes<32>;

// ---------------------------------------------------------------------
// PRIVATE WITNESSES (implemented by the TypeScript driver)
// Witness results are UNTRUSTED prover-supplied input. Everything below is
// constrained in-circuit before it is relied on.
// ---------------------------------------------------------------------

// The caller's root secret. Whoever is calling -- admin or holder --
// supplies their own. Role identities are derived from it with distinct
// domain separators so the derivations stay uncorrelated.
witness localSecret(): Bytes<32>;

// The issuer's authorisation secret. Replaces the reference version's
// `issuerSig()`. Read only by issueCredential and revokeCredential; a
// holder presenting a credential never supplies it and never needs it.
witness issuerSecret(): Bytes<32>;

// The holder's attribute values. These are the secrets the whole design
// exists to protect. They are read inside present() and never disclosed.
witness attributes(): CredentialAttrs;

// The commitment's blinding factor. Must be freshly random per credential:
// reusing it across commitments would make them linkable.
witness blinding(): Bytes<32>;

// A Merkle path proving the credential's leaf is still in the active set.
// Built off-chain by the TypeScript driver. Goes stale whenever the tree
// changes -- the holder must refresh it.
witness merklePath(): MerkleTreePath<10, Bytes<32>>;

// ---------------------------------------------------------------------
// IDENTITY DERIVATION
// Domain separation prevents a value derived for one purpose from being
// replayed as another.
// ---------------------------------------------------------------------

pure circuit deriveAdminId(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "cred:admin:v1"), sk]);
}

// Exported so the TypeScript driver derives holder identifiers with the
// EXACT same code the circuit uses. Reimplementing it off-chain would be a
// standing opportunity for the two to drift apart.
export pure circuit deriveHolderId(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "cred:holder:v1"), sk]);
}

// The value published in `issuerAuth`. Exported so the issuer's TypeScript
// side computes its registration digest with the circuit's own code.
export pure circuit deriveIssuerAuth(isk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "cred:issuer-auth:v1"), isk]);
}

// ---------------------------------------------------------------------
// COMMITMENT AND LEAF
// ---------------------------------------------------------------------

// The credential commitment. Binding (the holder cannot later claim
// different attributes) and hiding (the random blinding factor means the
// commitment reveals nothing about the attributes). Exported so the issuer
// and holder compute it with the same code the circuit verifies against.
export pure circuit credentialCommitment(attrs: CredentialAttrs, blinding: Bytes<32>): Bytes<32> {
  return persistentCommit<CredentialAttrs>(attrs, blinding);
}

// What actually goes into the tree.
//
// This is the substitute for the issuer's signature, and it is the reason
// the port is sound. The reference version stores the bare commitment as
// the leaf and re-checks a signature over (commitment, holderId) at every
// presentation. Here there is no signature to re-check, so the binding is
// moved INTO the leaf: a leaf is only ever written by issueCredential,
// which requires the issuer secret, and the leaf fixes which holder and
// which issuer it belongs to.
//
// Consequences that matter:
//   * A stolen commitment is useless. Presenting requires re-deriving
//     holderId from a secret only the bound holder knows, and a different
//     holderId produces a different leaf, which is not in the tree. (I7)
//   * Claiming a different issuer is useless for the same reason -- the
//     issuer id is inside the hash. (I6)
export pure circuit credentialLeaf(
  commitment: Bytes<32>,
  holderId:   Bytes<32>,
  issuerId:   Uint<16>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "cred:leaf:v1"),
    commitment,
    holderId,
    issuerId as Bytes<32>
  ]);
}

// ---------------------------------------------------------------------
// AUTHORISATION
// ---------------------------------------------------------------------

circuit assertAdmin(): [] {
  // Proves in-circuit that the caller knows the preimage of `admin`.
  // Copying the public ledger value into a proof input does not help an
  // attacker: they cannot produce a secret that hashes to it.
  assert(deriveAdminId(localSecret()) == admin, "caller is not the admin");
}

// The signature check's replacement. `issuerSecret()` is witness-supplied
// and therefore untrusted; the assert is what makes it trustworthy, by
// requiring it to hash to a value the admin published.
circuit assertIssuerAuthorised(issuerId: Uint<16>): [] {
  assert(issuerAuth.member(issuerId), "unregistered issuer");
  assert(deriveIssuerAuth(issuerSecret()) == issuerAuth.lookup(issuerId),
         "caller does not hold this issuer's secret");
}

// Authorise an issuer by publishing the digest of its authorisation secret.
//
// The admin publishes the digest; the issuer keeps the preimage. Note the
// admin therefore learns the digest but not necessarily the secret -- in a
// real deployment the issuer generates the secret and sends only the digest.
export circuit registerIssuer(issuerId: Uint<16>, authDigest: Bytes<32>): [] {
  assertAdmin();
  // disclose x2: exported circuit parameters. The compiler conservatively
  // taints parameters as potentially witness-derived, but the set of
  // authorised issuers is public by design -- verifiers must be able to see
  // who may issue. `authDigest` is a one-way hash of a secret that stays
  // with the issuer.
  const id = disclose(issuerId);
  assert(!issuerAuth.member(id), "issuer already registered");
  issuerAuth.insert(id, disclose(authDigest));
}

// ---------------------------------------------------------------------
// ISSUANCE
// ---------------------------------------------------------------------

// Insert a credential leaf into the active set.
//
// Authorisation is proof of knowledge of the issuer secret. The ledger sees
// only the leaf -- hiding, because the commitment inside it is blinded.
export circuit issueCredential(
  issuerId:   Uint<16>,
  commitment: Bytes<32>,
  holderId:   Bytes<32>,
  leafIndex:  Uint<64>
): [] {
  // disclose x4: all are exported circuit parameters that are public by
  // design. `issuerId` names a public registry entry; `commitment` is a
  // hiding commitment whose preimage stays private; `holderId` is a one-way
  // hash of the holder's secret; `leafIndex` is a public tree position.
  // None reveals an attribute value.
  const iid = disclose(issuerId);
  const c   = disclose(commitment);
  const hid = disclose(holderId);
  const idx = disclose(leafIndex);

  assertIssuerAuthorised(iid);

  assert(!activeCredentials.isFull(), "active credential tree is full");
  // Without this, an issuer could overwrite a live credential by reusing its
  // slot -- silently destroying it while leaving the holder none the wiser.
  assert(!leafIssuer.member(idx), "leaf index already in use");

  activeCredentials.insertIndex(credentialLeaf(c, hid, iid), idx);
  leafIssuer.insert(idx, iid);
}

// ---------------------------------------------------------------------
// REVOCATION
// ---------------------------------------------------------------------

// Revoke by tombstoning the leaf.
//
// There is no remove() on HistoricMerkleTree; insertIndexDefault is the
// documented way to emulate removal. The issuer therefore has to remember
// each credential's leaf index -- an unavoidable consequence of the ADT.
//
// resetHistory() is REQUIRED here, not optional. Without it, a revoked
// holder could still present against a root from before the revocation,
// because HistoricMerkleTree.checkRoot accepts ANY past root. That would
// break invariant I2 outright. Clearing history is what makes revocation
// take effect immediately.
//
// The cost is honest and is surfaced in the UI: every holder's Merkle path
// goes stale on any revocation and must be refreshed.
//
// The reference version binds its revocation signature to the current epoch
// so an old signature cannot be replayed. That is unnecessary here: the
// authorisation is a fresh in-circuit proof of knowledge rather than a
// detached object, so there is nothing to capture and replay.
export circuit revokeCredential(issuerId: Uint<16>, leafIndex: Uint<64>): [] {
  const iid = disclose(issuerId);
  const idx = disclose(leafIndex);

  assertIssuerAuthorised(iid);

  // Occupancy check: revoking an empty slot is a no-op for the tree but
  // still resets history for every holder. Refusing it removes a free
  // denial-of-service vector.
  assert(leafIssuer.member(idx), "no credential at that leaf index");
  // Ownership check: only the issuer that minted a credential may revoke it.
  assert(leafIssuer.lookup(idx) == iid, "credential belongs to another issuer");

  activeCredentials.insertIndexDefault(idx);
  leafIssuer.remove(idx);
  activeCredentials.resetHistory();
  revocationEpoch.increment(1);
}

// ---------------------------------------------------------------------
// NULLIFIER -- the per-verifier unlinkability mechanism
// ---------------------------------------------------------------------

// How far in the past `asOf` may be. Compact has no top-level constants, so
// this is a pure circuit. Units are whatever the chain's block time uses
// How far in the past `asOf` may be, in SECONDS.
//
// Seconds, not milliseconds, and that is a correction rather than a
// choice. Compact's block time is `BlockContext.secondsSinceEpoch`, and
// compact-runtime builds it as
//
//   secondsSinceEpoch: BigInt(time ?? Math.floor(Date.now() / 1_000))
//                                    (compact-runtime/dist/circuit-context.js:47)
//
// so every `blockTime*` comparison is against seconds since the epoch.
// This repo previously assumed milliseconds and said so as an assumption.
// It was wrong, and the simulator could never catch it: the tests supply
// their own block time, so milliseconds were self-consistent there.
//
// Verified on preview against the deployed contract: `present()` with an
// `asOf` in milliseconds is rejected with "asOf is in the future"; the
// same call in seconds is accepted. See RESEARCH.md §H.11.
//
// The unit matters beyond whether the call runs. Read as seconds, the old
// 300000 is a window of about three and a half days.
pure circuit freshnessWindow(): Uint<64> {
  return 300;
}

// nullifier = H(domain, holderSecret, verifierId, epoch)
//
// Because the holder's secret is hashed together with the verifier's id,
// the same holder produces an unrelated-looking value at each verifier.
// Two verifiers comparing their spent-nullifier lists learn nothing: to
// link them they would have to invert the hash, which needs holderSecret.
//
// Within one verifier and one epoch the value is deterministic, so a second
// presentation collides with the first and is caught as a replay.
//
// Exported so tests and the verifier UI can predict the nullifier for a
// given (secret, verifier, epoch) without running the full circuit. That is
// what makes the unlinkability property (I5) directly testable.
export pure circuit nullifierAt(
  sk:         Bytes<32>,
  verifierId: Bytes<32>,
  epoch:      Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "cred:nullifier:v1"),
    sk,
    verifierId,
    epoch
  ]);
}

// Impure wrapper binding the nullifier to the CURRENT on-chain epoch.
circuit nullifierFor(sk: Bytes<32>, verifierId: Bytes<32>): Bytes<32> {
  return nullifierAt(sk, verifierId, revocationEpoch as Bytes<32>);
}

// ---------------------------------------------------------------------
// PREDICATES
// ---------------------------------------------------------------------
// PRIVACY NOTE -- the important part of this section.
// Every check compares private attribute values against `asOf`, a PUBLIC
// timestamp supplied by the caller. Comparison results feed an assert; the
// operands never reach a public boundary, so no attribute value and no
// bound on one is disclosed.
//
// This is deliberately NOT done with blockTimeGte(attrs.birthTimestamp + N).
// That formulation looks natural and is a privacy hole: the argument to a
// blockTime* call must be disclosed, and since N is public, disclosing
// birthTimestamp + N reveals birthTimestamp exactly. The `asOf` indirection
// avoids it entirely -- the caller proves `asOf` is recent using public
// values only, then all private comparisons happen against `asOf`.

// Fixed 8-way disjunction rather than a fold over the vector. Compact has
// no mutable locals, so an accumulating loop would need fold with an
// anonymous circuit; an explicit chain is longer but obviously correct, and
// the width is fixed at 8 anyway. Unused slots are filled with 0 by the
// caller, and 0 is not a valid ISO 3166-1 numeric code, so padding cannot
// accidentally match a real country.
export pure circuit countryAllowed(code: Uint<16>, allowed: Vector<8, Uint<16>>): Boolean {
  return (code == allowed[0])
      || (code == allowed[1])
      || (code == allowed[2])
      || (code == allowed[3])
      || (code == allowed[4])
      || (code == allowed[5])
      || (code == allowed[6])
      || (code == allowed[7]);
}

// Returns whether the predicate holds. The caller asserts on the result --
// a Boolean-returning check enforces nothing on its own.
export pure circuit evalPredicate(
  req:   PredicateRequest,
  attrs: CredentialAttrs,
  asOf:  Uint<64>
): Boolean {
  if (req.predicateId == PredicateId.AGE_AT_LEAST) {
    // born early enough that `threshold` has already elapsed by `asOf`
    return (attrs.birthTimestamp + req.threshold) <= asOf;
  }
  if (req.predicateId == PredicateId.TIER_AT_LEAST) {
    return (attrs.kycTier as Uint<64>) >= req.threshold;
  }
  if (req.predicateId == PredicateId.COUNTRY_IN_SET) {
    return countryAllowed(attrs.countryCode, req.allowedCountries);
  }
  // Unknown predicate id: fail closed.
  return false;
}

// ---------------------------------------------------------------------
// PRESENTATION -- the circuit everything else exists to support
// ---------------------------------------------------------------------

// Prove to `verifierId` that the caller holds a live, unexpired credential
// from an authorised issuer satisfying `req`, revealing none of:
//   the attribute values, which credential it is, or that this holder has
//   presented to any other verifier.
//
// `asOf` is a PUBLIC timestamp. It exists so that every check against a
// private value is a private-to-public comparison whose result only feeds
// an assert, rather than a blockTime* call whose argument must be disclosed.
export circuit present(
  issuerId:   Uint<16>,
  verifierId: Bytes<32>,
  req:        PredicateRequest,
  asOf:       Uint<64>
): [] {
  // disclose x4: all are exported circuit parameters and all are public by
  // design. The verifier must know who it is, which issuer is being
  // claimed, what was asked, and as of when. None is attribute data.
  const iid     = disclose(issuerId);
  const vid     = disclose(verifierId);
  const now     = disclose(asOf);
  const request = disclose(req);

  // --- asOf must be recent -------------------------------------------
  // Pinning asOf to (blockTime - window, blockTime] is what stops a holder
  // choosing a convenient timestamp. Too far forward would fake age; too
  // far back would resurrect an expired credential. Both arguments here
  // are public, so no private bound leaks.
  assert(blockTimeGte(now), "asOf is in the future");
  assert(blockTimeLt((now + freshnessWindow()) as Uint<64>), "asOf is stale");

  // The claimed issuer must still be in the registry. Tree membership below
  // already implies an authorised issuer wrote this leaf, so this check is
  // belt-and-braces rather than load-bearing; it is cheap and it makes the
  // rejection message accurate when an unknown issuer id is supplied.
  assert(issuerAuth.member(iid), "unregistered issuer");

  const sk       = localSecret();
  const holderId = deriveHolderId(sk);
  const attrs    = attributes();

  // Recompute the commitment from private data. Binding: the holder cannot
  // later claim different attributes for the same commitment. Hiding: the
  // random blinding factor makes the commitment reveal nothing.
  const commitment = credentialCommitment(attrs, blinding());

  // (a) + (b) The leaf binds the commitment to THIS holder and THIS issuer.
  //           Only issueCredential can write a leaf, and it requires the
  //           issuer secret, so a leaf in the tree is the attestation.
  //           Enforces I6 and I7.
  const leaf = credentialLeaf(commitment, holderId, iid);

  // (c) still in the active set  => not revoked. Enforces I2.
  const path = merklePath();
  // Bind the path to THIS credential. Without this the prover could submit
  // a valid path for somebody else's live leaf and pass the membership
  // check with a revoked credential of their own.
  assert(path.leaf == leaf, "Merkle path is not for this credential");
  const root = merkleTreePathRoot<10, Bytes<32>>(path);
  // disclose: `root` is a Merkle root of PUBLIC ledger state. It is
  // recomputed from a private path, hence witness-derived, but the value
  // itself is already public information -- it is literally the tree's root.
  assert(activeCredentials.checkRoot(disclose(root)),
         "credential is not in the active set (revoked or path stale)");

  // (d) not expired. Enforces I3. Private comparison; expiresAt never
  //     reaches a public boundary, so nothing about it is revealed beyond
  //     the single bit "still valid".
  assert(now < attrs.expiresAt, "credential has expired");

  // (e) the requested predicate holds. Private comparison, same reasoning.
  assert(evalPredicate(request, attrs, now), "predicate not satisfied");

  // (f) replay check. Enforces I4.
  const n = nullifierFor(sk, vid);
  // disclose x2: the nullifier is a one-way hash of the holder's secret
  // salted by verifier and epoch. Publishing it is the entire mechanism --
  // it must be public for double-presentation to be detectable. It cannot
  // be correlated with this holder's nullifier at any other verifier
  // without inverting persistentHash.
  assert(!spentNullifiers.member(disclose(n)), "nullifier already spent this epoch");
  spentNullifiers.insert(disclose(n), true);
}

// ---------------------------------------------------------------------
// CONSTRUCTOR
// ---------------------------------------------------------------------

constructor() {
  // disclose: the admin IDENTIFIER is a one-way hash of the deployer's
  // secret, published deliberately so later calls can prove preimage
  // knowledge against it. The secret itself never leaves private state.
  admin = disclose(deriveAdminId(localSecret()));
}
